---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	id?: string;
};

const { title, description, pubDate, updatedDate, heroImage, id = '' } = Astro.props;

function getLangFromId(postId: string): string {
	const match = postId.match(/-(ru|es|de|fr|zh)$/);
	return match ? match[1] : 'en';
}

const currentLang = getLangFromId(id);

const backLabels: Record<string, string> = {
	en: 'All engineering logs',
	ru: 'Все инженерные заметки',
	es: 'Todas las notas de ingeniería',
	de: 'Alle Engineering-Notizen',
	fr: 'Toutes les notes d’ingénierie',
	zh: '返回所有工程日志',
};

const dateLocales: Record<string, string> = {
	en: 'en-us',
	ru: 'ru-ru',
	es: 'es-es',
	de: 'de-de',
	fr: 'fr-fr',
	zh: 'zh-cn',
};

const articleBadges: Record<string, string> = {
	en: 'Article',
	ru: 'Статья',
	es: 'Artículo',
	de: 'Artikel',
	fr: 'Article',
	zh: '文章',
};
---

<!doctype html>
<html lang={currentLang}>
	<head>
		<BaseHead title={`${title} — Blog`} description={description} image={heroImage} />
	</head>

	<body class="blog-post-page">
		<div class="hex-field" aria-hidden="true"></div>
		<Header />
		<main class="blog-post-layout">
			<nav class="blog-post__nav" aria-label="Breadcrumb">
				<a class="blog-post__back-btn" href={`/blog?lang=${currentLang}`}>
					<svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
						<path
							d="M10.5 3.5L5.5 8L10.5 12.5"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="square"
						/>
					</svg>
					<span>{backLabels[currentLang] || 'All engineering logs'}</span>
				</a>
			</nav>

			<article class="blog-post">
				<header class="blog-post__header">
					<div class="blog-post__meta">
						<span class="blog-post__badge">{articleBadges[currentLang] || 'Article'}</span>
						<span class="blog-post__date">
							<FormattedDate
								date={pubDate}
								locale={dateLocales[currentLang] || 'en-us'}
							/>
						</span>
						{
							updatedDate && (
								<span class="blog-post__updated">
									Updated{' '}
									<FormattedDate
										date={updatedDate}
										locale={dateLocales[currentLang] || 'en-us'}
									/>
								</span>
							)
						}
					</div>

					<h1 class="blog-post__title">{title}</h1>

					{
						heroImage && (
							<div class="blog-post__hero-media">
								<Image
									width={1200}
									height={630}
									src={heroImage}
									alt=""
									loading="eager"
								/>
							</div>
						)
					}
				</header>

				<div class="prose">
					<slot />
				</div>

				<footer class="blog-post__footer">
					<hr class="blog-post__footer-divider" />
					<div class="blog-post__footer-actions">
						<a class="blog-post__back-btn" href={`/blog?lang=${currentLang}`}>
							<svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
								<path
									d="M10.5 3.5L5.5 8L10.5 12.5"
									stroke="currentColor"
									stroke-width="1.5"
									stroke-linecap="square"
								/>
							</svg>
							<span>{backLabels[currentLang] || 'Back to all engineering logs'}</span>
						</a>
					</div>
				</footer>
			</article>
		</main>

		<script>
			import { initHexParallax } from '../scripts/hex-parallax';

			const hexField = document.querySelector<HTMLElement>('.hex-field');
			if (hexField) initHexParallax(hexField);
		</script>

		<style>
			.blog-post-page {
				position: relative;
				overflow-x: clip;
				background:
					radial-gradient(
						circle at 78% 8%,
						rgba(155, 123, 255, 0.08),
						transparent 25rem
					),
					var(--void);
			}

			.blog-post-layout {
				position: relative;
				z-index: 1;
				width: min(100% - 2 * var(--page-gutter), 48rem) !important;
				margin: 0 auto;
				padding: 8rem 0 8rem !important;
			}

			.blog-post__nav {
				display: flex;
				align-items: center;
				justify-content: flex-start;
				margin-bottom: 2.5rem;
			}

			.blog-post__back-btn {
				position: relative;
				display: inline-flex;
				align-items: center;
				gap: 0.65rem;
				min-height: 2.75rem;
				padding: 0 1.25rem;
				background-color: rgba(242, 245, 243, 0.22);
				color: var(--paper);
				text-decoration: none;
				font-family: var(--font-accent);
				font-size: 0.68rem;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				isolation: isolate;
				clip-path: polygon(
					0.65rem 0,
					100% 0,
					100% calc(100% - 0.65rem),
					calc(100% - 0.65rem) 100%,
					0 100%,
					0 0.65rem
				);
				transition:
					background-color 180ms ease,
					color 180ms ease;
			}

			.blog-post__back-btn::before {
				position: absolute;
				inset: 1px;
				z-index: -1;
				background-color: var(--carbon);
				clip-path: inherit;
				content: '';
				transition: background-color 180ms ease;
			}

			.blog-post__back-btn svg {
				width: 0.85rem;
				height: 0.85rem;
				transition: transform 180ms ease;
			}

			.blog-post__back-btn:hover,
			.blog-post__back-btn:focus-visible {
				background-color: var(--bunderstack-violet);
				color: #ffffff;
			}

			.blog-post__back-btn:hover::before,
			.blog-post__back-btn:focus-visible::before {
				background-color: color-mix(in srgb, var(--carbon) 90%, var(--bunderstack-violet));
			}

			.blog-post__back-btn:hover svg,
			.blog-post__back-btn:focus-visible svg {
				transform: translateX(-0.25rem);
			}

			.blog-post__header {
				margin-bottom: 3.5rem;
			}

			.blog-post__meta {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.65rem;
				margin-bottom: 1.5rem;
				font-family: var(--font-utility);
				font-size: 0.68rem;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--muted);
			}

			.blog-post__meta span {
				display: inline-flex;
				align-items: center;
				padding: 0.35rem 0.85rem;
				background-color: rgba(242, 245, 243, 0.08);
				clip-path: polygon(
					0.45rem 0,
					calc(100% - 0.45rem) 0,
					100% 50%,
					calc(100% - 0.45rem) 100%,
					0.45rem 100%,
					0 50%
				);
			}

			.blog-post__badge {
				color: #ffffff;
				background-color: rgba(155, 123, 255, 0.28) !important;
				border: 1px solid rgba(155, 123, 255, 0.38);
			}

			.blog-post__title {
				margin: 0 0 1.25rem;
				font-size: clamp(2.4rem, 5.2vw, 4.2rem);
				font-weight: 800;
				letter-spacing: -0.038em;
				line-height: 1.04;
				color: var(--paper);
			}

			.blog-post__hero-media {
				position: relative;
				margin-top: 2rem;
				padding: 1px;
				background-color: rgba(242, 245, 243, 0.22);
				clip-path: polygon(
					1.5rem 0,
					100% 0,
					100% calc(100% - 1.5rem),
					calc(100% - 1.5rem) 100%,
					0 100%,
					0 1.5rem
				);
			}

			.blog-post__hero-media img {
				display: block;
				width: 100%;
				max-height: 440px;
				object-fit: contain;
				padding: clamp(1.5rem, 3vw, 2.5rem);
				background: radial-gradient(circle at center, rgba(155, 123, 255, 0.12), #07080b);
				clip-path: inherit;
			}

			/* Prose article typography */
			.prose {
				color: var(--paper);
				font-size: clamp(1.05rem, 1.4vw, 1.15rem);
				line-height: 1.75;
			}

			.prose :global(p) {
				margin: 1.5rem 0;
				color: rgba(242, 245, 243, 0.88);
			}

			.prose :global(h2) {
				margin: 3.5rem 0 1.25rem;
				font-size: clamp(1.75rem, 2.8vw, 2.35rem);
				font-weight: 800;
				letter-spacing: -0.03em;
				line-height: 1.15;
				color: var(--paper);
			}

			.prose :global(h3) {
				margin: 2.5rem 0 1rem;
				font-size: clamp(1.35rem, 2vw, 1.65rem);
				font-weight: 800;
				letter-spacing: -0.025em;
				line-height: 1.2;
				color: var(--paper);
			}

			.prose :global(ul),
			.prose :global(ol) {
				margin: 1.5rem 0;
				padding-left: 1.5rem;
				color: rgba(242, 245, 243, 0.84);
			}

			.prose :global(li) {
				margin: 0.6rem 0;
				line-height: 1.65;
			}

			.prose :global(blockquote) {
				margin: 2.2rem 0;
				padding: 1rem 1.5rem;
				background-color: rgba(155, 123, 255, 0.06);
				border-left: 3px solid var(--bunderstack-violet);
				color: var(--paper);
				font-style: normal;
			}

			.prose :global(blockquote p) {
				margin: 0;
			}

			.prose :global(code) {
				font-family: var(--font-accent);
				font-size: 0.88em;
				padding: 0.2em 0.45em;
				background-color: rgba(242, 245, 243, 0.08);
				border: 1px solid rgba(242, 245, 243, 0.12);
				border-radius: 4px;
				color: var(--bunderstack-violet);
			}

			.prose :global(pre) {
				margin: 2rem 0;
				padding: 1.25rem 1.5rem;
				background-color: var(--carbon) !important;
				border: 1px solid rgba(242, 245, 243, 0.12);
				border-radius: 8px;
				overflow-x: auto;
			}

			.prose :global(pre code) {
				background-color: transparent;
				border: 0;
				padding: 0;
				color: inherit;
				font-size: 0.9em;
			}

			.prose :global(a) {
				color: var(--bunderstack-violet);
				text-decoration: underline;
				text-underline-offset: 3px;
				transition: color 180ms ease;
			}

			.prose :global(a:hover) {
				color: #ffffff;
			}

			.prose :global(table) {
				width: 100%;
				margin: 2rem 0;
				border-collapse: collapse;
				font-size: 0.95rem;
			}

			.prose :global(th),
			.prose :global(td) {
				padding: 0.75rem 1rem;
				border: 1px solid rgba(242, 245, 243, 0.12);
				text-align: left;
			}

			.prose :global(th) {
				background-color: rgba(242, 245, 243, 0.06);
				font-family: var(--font-accent);
				text-transform: uppercase;
				letter-spacing: 0.08em;
				font-size: 0.72rem;
				color: var(--muted);
			}

			.blog-post__footer {
				margin-top: 4rem;
			}

			.blog-post__footer-divider {
				border: 0;
				border-top: 1px solid rgba(242, 245, 243, 0.14);
				margin-bottom: 2.5rem;
			}

			.blog-post__footer-actions {
				display: flex;
				justify-content: flex-start;
			}

			@media (max-width: 720px) {
				.blog-post-layout {
					padding-top: 6.5rem !important;
				}

				.blog-post__header {
					margin-bottom: 2.5rem;
				}
			}
		</style>
	</body>
</html>
