---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} — Blog`} description={description} image={heroImage} />
	</head>

	<body class="blog-post-page">
		<div class="hex-field" aria-hidden="true"></div>
		<Header />
		<main class="blog-post-layout">
			<nav class="blog-post__nav" aria-label="Breadcrumb">
				<a class="blog-post__back-btn" href="/blog">
					<svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
						<path
							d="M10.5 3.5L5.5 8L10.5 12.5"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="square"
						/>
					</svg>
					<span>All engineering logs</span>
				</a>
			</nav>

			<article class="blog-post">
				<header class="blog-post__header">
					<div class="blog-post__meta">
						<span class="blog-post__badge">Article</span>
						<span class="blog-post__date">
							<FormattedDate date={pubDate} />
						</span>
						{
							updatedDate && (
								<span class="blog-post__updated">
									Updated <FormattedDate date={updatedDate} />
								</span>
							)
						}
					</div>

					<h1 class="blog-post__title">{title}</h1>

					{
						heroImage && (
							<div class="blog-post__hero-media">
								<Image
									width={1200}
									height={630}
									src={heroImage}
									alt=""
									loading="eager"
								/>
							</div>
						)
					}
				</header>

				<div class="prose">
					<slot />
				</div>

				<footer class="blog-post__footer">
					<hr class="blog-post__footer-divider" />
					<div class="blog-post__footer-actions">
						<a class="blog-post__back-btn" href="/blog">
							<svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
								<path
									d="M10.5 3.5L5.5 8L10.5 12.5"
									stroke="currentColor"
									stroke-width="1.5"
									stroke-linecap="square"
								/>
							</svg>
							<span>Back to all engineering logs</span>
						</a>
					</div>
				</footer>
			</article>
		</main>

		<script>
			import { initHexParallax } from '../scripts/hex-parallax';

			const hexField = document.querySelector<HTMLElement>('.hex-field');
			if (hexField) initHexParallax(hexField);
		</script>

		<style>
			.blog-post-page {
				position: relative;
				overflow-x: clip;
				background:
					radial-gradient(
						circle at 78% 8%,
						rgba(155, 123, 255, 0.08),
						transparent 25rem
					),
					var(--void);
			}

			.blog-post-layout {
				position: relative;
				z-index: 1;
				width: min(100% - 2 * var(--page-gutter), 54rem) !important;
				margin: 0 auto;
				padding: 7.5rem 0 8rem !important;
			}

			.blog-post__nav {
				margin-bottom: 2.5rem;
			}

			.blog-post__back-btn {
				display: inline-flex;
				align-items: center;
				gap: 0.65rem;
				min-height: 2.75rem;
				padding: 0 1.25rem;
				border: 1px solid rgba(242, 245, 243, 0.2);
				background: rgba(11, 13, 18, 0.7);
				color: var(--paper);
				text-decoration: none;
				font-family: var(--font-accent);
				font-size: 0.68rem;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				clip-path: polygon(
					0.6rem 0,
					100% 0,
					100% calc(100% - 0.6rem),
					calc(100% - 0.6rem) 100%,
					0 100%,
					0 0.6rem
				);
				transition:
					border-color 180ms ease,
					background-color 180ms ease,
					color 180ms ease;
			}

			.blog-post__back-btn svg {
				width: 0.85rem;
				height: 0.85rem;
				transition: transform 180ms ease;
			}

			.blog-post__back-btn:hover,
			.blog-post__back-btn:focus-visible {
				border-color: var(--bunderstack-violet);
				background: rgba(155, 123, 255, 0.1);
				color: var(--paper);
			}

			.blog-post__back-btn:hover svg,
			.blog-post__back-btn:focus-visible svg {
				transform: translateX(-0.25rem);
			}

			.blog-post__header {
				margin-bottom: 3.5rem;
			}

			.blog-post__meta {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.65rem;
				margin-bottom: 1.5rem;
				font-family: var(--font-utility);
				font-size: 0.68rem;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--muted);
			}

			.blog-post__meta span {
				display: inline-flex;
				align-items: center;
				padding: 0.35rem 0.85rem;
				background-color: rgba(242, 245, 243, 0.08);
				clip-path: polygon(
					0.45rem 0,
					calc(100% - 0.45rem) 0,
					100% 50%,
					calc(100% - 0.45rem) 100%,
					0.45rem 100%,
					0 50%
				);
			}

			.blog-post__badge {
				color: #ffffff;
				background-color: rgba(155, 123, 255, 0.28) !important;
				border: 1px solid rgba(155, 123, 255, 0.38);
			}

			.blog-post__title {
				margin: 0 0 1.25rem;
				font-size: clamp(2.4rem, 5.2vw, 4.2rem);
				font-weight: 800;
				letter-spacing: -0.038em;
				line-height: 1.04;
				color: var(--paper);
			}

			.blog-post__lead {
				font-size: clamp(1.15rem, 1.8vw, 1.35rem);
				line-height: 1.55;
				color: var(--muted);
				margin: 0 0 2.5rem;
				max-width: 48rem;
			}

			.blog-post__hero-media {
				position: relative;
				margin-top: 2rem;
				padding: 1px;
				background-color: rgba(242, 245, 243, 0.22);
				clip-path: polygon(
					1.5rem 0,
					100% 0,
					100% calc(100% - 1.5rem),
					calc(100% - 1.5rem) 100%,
					0 100%,
					0 1.5rem
				);
			}

			.blog-post__hero-media img {
				display: block;
				width: 100%;
				max-height: 440px;
				object-fit: contain;
				padding: clamp(1.5rem, 3vw, 2.5rem);
				background: radial-gradient(circle at center, rgba(155, 123, 255, 0.12), #07080b);
				clip-path: inherit;
			}

			/* Prose article typography */
			.prose {
				color: var(--paper);
				font-size: clamp(1.05rem, 1.3vw, 1.15rem);
				line-height: 1.76;
			}

			.prose :global(p) {
				margin: 0 0 1.65em;
			}

			.prose :global(h1),
			.prose :global(h2),
			.prose :global(h3),
			.prose :global(h4),
			.prose :global(h5),
			.prose :global(h6) {
				color: var(--paper);
				font-family: var(--font-display);
				font-weight: 800;
				letter-spacing: -0.03em;
				line-height: 1.12;
			}

			.prose :global(h1) {
				font-size: clamp(2rem, 4vw, 3rem);
				margin: 3.5rem 0 1.25rem;
			}

			.prose :global(h2) {
				font-size: clamp(1.65rem, 3vw, 2.3rem);
				margin: 3.25rem 0 1.15rem;
				padding-bottom: 0.4rem;
				border-bottom: 1px solid rgba(242, 245, 243, 0.12);
			}

			.prose :global(h3) {
				font-size: clamp(1.35rem, 2.2vw, 1.75rem);
				margin: 2.5rem 0 0.9rem;
			}

			.prose :global(h4) {
				font-size: 1.25rem;
				margin: 2rem 0 0.75rem;
			}

			.prose :global(strong),
			.prose :global(b) {
				color: #ffffff;
				font-weight: 700;
			}

			.prose :global(a) {
				color: var(--bunderstack-violet);
				text-decoration: underline;
				text-underline-offset: 0.22em;
				transition: color 160ms ease;
			}

			.prose :global(a:hover) {
				color: #c4b5fd;
			}

			.prose :global(code) {
				padding: 0.18em 0.42em;
				border-radius: 4px;
				background: rgba(242, 245, 243, 0.08);
				border: 1px solid rgba(242, 245, 243, 0.12);
				font-family: var(--font-utility);
				font-size: 0.88em;
				color: var(--paper);
			}

			.prose :global(pre) {
				margin: 2rem 0;
				padding: 1.35rem 1.6rem;
				background-color: var(--carbon);
				border: 1px solid rgba(242, 245, 243, 0.14);
				border-radius: 8px;
				overflow-x: auto;
				font-family: var(--font-utility);
				font-size: 0.92rem;
				line-height: 1.62;
			}

			.prose :global(pre code) {
				all: unset;
				font-family: var(--font-utility);
			}

			.prose :global(blockquote) {
				margin: 2.25rem 0;
				padding: 1.1rem 1.6rem;
				border-left: 3px solid var(--bunderstack-violet);
				background: rgba(155, 123, 255, 0.06);
				color: var(--paper);
			}

			.prose :global(blockquote p:last-child) {
				margin-bottom: 0;
			}

			.prose :global(ul),
			.prose :global(ol) {
				margin: 1.4rem 0 1.8rem;
				padding-left: 1.8rem;
			}

			.prose :global(li) {
				margin-bottom: 0.65rem;
			}

			.prose :global(li::marker) {
				color: var(--bunderstack-violet);
			}

			.prose :global(img) {
				display: block;
				max-width: 100%;
				height: auto;
				margin: 2.5rem auto;
				border-radius: 6px;
				border: 1px solid rgba(242, 245, 243, 0.14);
			}

			.prose :global(hr) {
				margin: 3.5rem 0;
				border: 0;
				border-top: 1px solid rgba(242, 245, 243, 0.14);
			}

			.prose :global(table) {
				width: 100%;
				margin: 2rem 0;
				border-collapse: collapse;
				font-size: 0.95rem;
			}

			.prose :global(th),
			.prose :global(td) {
				padding: 0.75rem 1rem;
				border: 1px solid rgba(242, 245, 243, 0.12);
				text-align: left;
			}

			.prose :global(th) {
				background-color: rgba(242, 245, 243, 0.06);
				font-family: var(--font-accent);
				text-transform: uppercase;
				letter-spacing: 0.08em;
				font-size: 0.72rem;
				color: var(--muted);
			}

			.blog-post__footer {
				margin-top: 4rem;
			}

			.blog-post__footer-divider {
				border: 0;
				border-top: 1px solid rgba(242, 245, 243, 0.14);
				margin-bottom: 2.5rem;
			}

			.blog-post__footer-actions {
				display: flex;
				justify-content: flex-start;
			}

			@media (max-width: 720px) {
				.blog-post-layout {
					padding-top: 6.5rem !important;
				}

				.blog-post__header {
					margin-bottom: 2.5rem;
				}
			}
		</style>
	</body>
</html>
