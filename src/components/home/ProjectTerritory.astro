---
import type { Project } from '../../data/projects';

interface Props {
	project: Project;
	index: number;
	imageSrc?: string;
	imageAlt?: string;
}

const { project, index, imageSrc, imageAlt } = Astro.props;
const territoryNumber = String(index + 1).padStart(2, '0');
---

<article
	id={project.id}
	class:list={['project-territory', { 'project-territory--featured': project.featured }]}
	data-project-id={project.id}
	data-scene-section={project.id}
	style={`--project-accent: ${project.accent}`}
>
	<div class="project-territory__trace" aria-hidden="true"></div>
	<header class="project-territory__header">
		<span class="project-territory__number" aria-hidden="true">{territoryNumber}</span>
		<div class="project-territory__labels" aria-label={`${project.role}, ${project.status}`}>
			<span>{project.role}</span>
			<span>{project.status}</span>
		</div>
	</header>

	<div class="project-territory__body">
		<div class="project-territory__copy">
			{project.featured && <p class="project-territory__kicker">The root system</p>}
			<h3>{project.name}</h3>
			<p>{project.description}</p>
			<a href={project.href} aria-label={`Visit ${project.name}`}>
				<span>Open project</span>
				<svg viewBox="0 0 42 14" aria-hidden="true">
					<path d="M1 7h36M31 2l6 5-6 5" />
				</svg>
			</a>
		</div>

		{
			imageSrc ? (
				<figure class="project-territory__media">
					<div class="project-territory__plate" aria-hidden="true" />
					<img src={imageSrc} alt={imageAlt} loading="lazy" decoding="async" />
				</figure>
			) : (
				<div class="project-territory__topology" aria-hidden="true">
					<span class="topology-node topology-node--origin">API</span>
					<span class="topology-node topology-node--one">RPC</span>
					<span class="topology-node topology-node--two">DB</span>
					<span class="topology-node topology-node--three">AUTH</span>
					<svg viewBox="0 0 460 230" preserveAspectRatio="none">
						<path d="M90 112H190L246 48H365M190 112l56 67h119M246 48v131" />
					</svg>
				</div>
			)
		}
	</div>
</article>
