---
import { Image } from 'astro:assets';
import avatarImg from '../../assets/avatar.jpg';
---

<section
  id="about"
  class="garden-hero"
  data-scene-section="hero"
  aria-labelledby="hero-title"
>
  <div class="garden-hero__portrait" aria-hidden="true">
    <div class="garden-hero__portrait-frame">
      <Image
        src={avatarImg}
        alt="kcrz — reduce complexity, touch grass"
        class="garden-hero__portrait-image"
        width={480}
        height={480}
        loading="eager"
      />
    </div>
    <div class="garden-hero__portrait-traces">
      <span class="garden-hero__portrait-trace garden-hero__portrait-trace--one"></span>
      <span class="garden-hero__portrait-trace garden-hero__portrait-trace--two"></span>
    </div>
  </div>

  <div class="garden-hero__copy">
    <h1 id="hero-title">
      I build backend systems and products that <span class="accent"
        >reduce complexity.</span
      >
    </h1>

    <div class="garden-hero__base">
      <p class="garden-hero__intro">
        Bunderstack is my current opus magnum: one typed foundation for the
        infrastructure and products below.
      </p>
      <a class="garden-hero__route" href="#work">
        <span>Enter the project garden</span>
        <svg viewBox="0 0 48 16" aria-hidden="true">
          <path d="M1 8h42M36 2l7 6-7 6"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
