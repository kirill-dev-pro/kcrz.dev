---
import { projects } from '../../data/projects';
import ProjectTerritory from './ProjectTerritory.astro';

interface ProjectMediaConfig {
	src: string;
	alt: string;
	logoSrc?: string;
	logoAlt?: string;
	stickerTag?: string;
}

const projectMedia: Partial<Record<(typeof projects)[number]['id'], ProjectMediaConfig>> = {
	bunderstack: {
		src: '/projects/bunderstack.webp',
		alt: 'Bunderstack preview: Your whole backend as a single file declaration.',
		logoSrc: '/projects/bunderstack-logo.png',
		logoAlt: 'Bunderstack logo',
		stickerTag: 'Proud',
	},
	bunderhost: {
		src: '/projects/bunderhost.webp',
		alt: 'Bunderhost interface showing one-click Bunderstack deploys with a live production deployment pipeline.',
	},
	hrbreakers: {
		src: '/projects/hrbreakers.png',
		alt: 'HR Breakers illustration of a job posting and resume becoming a targeted resume.',
	},
	'telegram-vpn': {
		src: '/projects/telegram-vpn.png',
		alt: 'Telegram VPN landing page screenshot with dark theme and server selection.',
	},
	klaud: {
		src: '/projects/klaud.webp',
		alt: 'Klaud dashboard showing a group and its connected OAuth applications.',
	},
	airealty: {
		src: '/projects/airealty.webp',
		alt: 'AI Realty landing page with a live promotion preview and campaign counters.',
	},
	iqdoc: {
		src: '/projects/iqdoc.png',
		alt: 'IQDOC search box with source filters for clinical guidelines, ESMO, ASA, and FAR.',
	},
};
---

<section id="work" class="project-garden" aria-label="Selected projects and products">
	<div class="project-garden__map">
		<div class="project-garden__grid">
			{
				projects.map((project) => {
					const media = projectMedia[project.id];
					return (
						<ProjectTerritory
							project={project}
							imageSrc={media?.src}
							imageAlt={media?.alt}
							logoSrc={media?.logoSrc}
							logoAlt={media?.logoAlt}
							stickerTag={media?.stickerTag}
						/>
					);
				})
			}
		</div>
	</div>
</section>
