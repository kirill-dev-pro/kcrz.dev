---
const today = new Date();
---

<footer>
	<div class="footer__inner">
		<p><span>Kcrz.dev</span> · reduce complexity, touch grass</p>
		<p>© {today.getFullYear()} Kirill Chuprov</p>
	</div>
</footer>

<style>
	footer {
		padding: 0 var(--page-gutter) 2rem;
		color: var(--muted);
	}

	.footer__inner {
		display: flex;
		justify-content: space-between;
		width: min(100%, var(--content-max));
		margin: 0 auto;
		padding-top: 1.5rem;
		border-top: 1px solid rgba(242, 245, 243, 0.14);
		font-family: var(--font-utility);
		font-size: 0.66rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	footer p {
		margin: 0;
	}

	footer span {
		color: var(--paper);
	}

	@media (max-width: 640px) {
		.footer__inner {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.75rem;
		}
	}
</style>
