---
interface Props {
	targetUrl: string;
	targetLang: 'ru' | 'en';
	label: string;
	actionText: string;
}

const { targetUrl, targetLang, label, actionText } = Astro.props;
---

<div class="lang-switch-banner">
	<div class="lang-switch-banner__content">
		<div class="lang-switch-banner__info">
			<svg
				class="lang-switch-banner__icon"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="1.8"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<circle cx="12" cy="12" r="10"></circle>
				<path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
				<path d="M2 12h20"></path>
			</svg>
			<span class="lang-switch-banner__label">{label}</span>
		</div>
		<a class="lang-switch-banner__action" href={targetUrl}>
			<span class="lang-switch-banner__lang-tag">{targetLang.toUpperCase()}</span>
			<span>{actionText}</span>
			<svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
				<path
					d="M6 3.5L10.5 8L6 12.5"
					stroke="currentColor"
					stroke-width="1.5"
					stroke-linecap="square"
				/>
			</svg>
		</a>
	</div>
</div>

<style>
	.lang-switch-banner {
		position: relative;
		margin: 0 0 2.5rem;
		padding: 1px;
		background: rgba(155, 123, 255, 0.22);
		clip-path: polygon(
			0.75rem 0,
			100% 0,
			100% calc(100% - 0.75rem),
			calc(100% - 0.75rem) 100%,
			0 100%,
			0 0.75rem
		);
		transition: background-color 180ms ease;
	}

	.lang-switch-banner:hover {
		background: var(--bunderstack-violet);
	}

	.lang-switch-banner__content {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.85rem 1.25rem;
		background-color: var(--carbon);
		clip-path: inherit;
	}

	.lang-switch-banner__info {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		color: var(--muted);
		font-size: 0.9rem;
	}

	.lang-switch-banner__icon {
		width: 1.1rem;
		height: 1.1rem;
		color: var(--bunderstack-violet);
		flex-shrink: 0;
	}

	.lang-switch-banner__label {
		color: var(--muted);
	}

	.lang-switch-banner__action {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-accent);
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--paper) !important;
		text-decoration: none !important;
		transition: color 180ms ease;
	}

	.lang-switch-banner__lang-tag {
		font-family: var(--font-utility);
		font-size: 0.65rem;
		padding: 0.15rem 0.45rem;
		background: rgba(155, 123, 255, 0.25);
		color: #ffffff;
		border-radius: 3px;
	}

	.lang-switch-banner__action svg {
		width: 0.85rem;
		height: 0.85rem;
		transition: transform 180ms ease;
	}

	.lang-switch-banner__action:hover {
		color: var(--bunderstack-violet) !important;
	}

	.lang-switch-banner__action:hover svg {
		transform: translateX(0.2rem);
	}

	@media (max-width: 600px) {
		.lang-switch-banner__content {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
