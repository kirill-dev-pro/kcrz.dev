---
import type { ImageMetadata } from 'astro';

interface Props {
	title: string;
	description: string;
	href: string;
	domain: string;
	badge?: string;
	accent?: string;
	icon?: ImageMetadata | string;
	cornerLogo?: ImageMetadata | string;
}

const {
	title,
	description,
	href,
	domain,
	badge,
	accent = 'var(--bunderstack-violet)',
	icon,
	cornerLogo,
} = Astro.props;

const iconSrc = typeof icon === 'object' && icon !== null && 'src' in icon ? icon.src : icon;
const cornerLogoSrc =
	typeof cornerLogo === 'object' && cornerLogo !== null && 'src' in cornerLogo
		? cornerLogo.src
		: cornerLogo;
---

<aside class="article-link-card" style={`--card-accent: ${accent}`}>
	<a class="article-link-card__link" href={href} target="_blank" rel="noopener noreferrer">
		{
			cornerLogoSrc && (
				<div class="article-link-card__watermark" aria-hidden="true">
					<div class="article-link-card__watermark-halo" />
					<img
						class="article-link-card__watermark-img article-link-card__watermark-img--sharp"
						src={cornerLogoSrc}
						alt=""
						loading="lazy"
						decoding="async"
					/>
					<img
						class="article-link-card__watermark-img article-link-card__watermark-img--blur"
						src={cornerLogoSrc}
						alt=""
						loading="lazy"
						decoding="async"
					/>
				</div>
			)
		}
		{
			iconSrc && (
				<div class="article-link-card__media">
					<img
						class="article-link-card__icon"
						src={iconSrc}
						alt={`${title} icon`}
						width="80"
						height="80"
						loading="lazy"
						decoding="async"
					/>
				</div>
			)
		}
		<div class="article-link-card__content">
			<div class="article-link-card__top">
				<div class="article-link-card__meta">
					<span class="article-link-card__domain">{domain}</span>
					{badge && <span class="article-link-card__badge">{badge}</span>}
				</div>
				<div class="article-link-card__arrow" aria-hidden="true">
					<svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
						<path
							d="M5.5 3.5H12.5V10.5"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="square"
						/>
						<path
							d="M12 4L3.5 12.5"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="square"
						/>
					</svg>
				</div>
			</div>
			<h4 class="article-link-card__title">{title}</h4>
			<p class="article-link-card__desc">{description}</p>
		</div>
	</a>
</aside>

<style>
	.article-link-card {
		--cut: 1.2rem;
		position: relative;
		margin: 2.2rem 0;
		background-color: rgba(242, 245, 243, 0.14);
		isolation: isolate;
		clip-path: polygon(
			0 0,
			calc(100% - var(--cut)) 0,
			100% var(--cut),
			100% 100%,
			var(--cut) 100%,
			0 calc(100% - var(--cut))
		);
		transition: background-color 180ms ease;
	}

	.article-link-card::before {
		position: absolute;
		inset: 1px;
		z-index: -1;
		background-color: var(--carbon);
		clip-path: inherit;
		content: '';
		transition:
			background-color 180ms ease,
			box-shadow 180ms ease;
	}

	.article-link-card:hover {
		background-color: var(--card-accent);
	}

	.article-link-card:hover::before {
		background-color: color-mix(in srgb, var(--carbon) 94%, var(--card-accent));
		box-shadow: inset 0 0 2.5rem color-mix(in srgb, var(--card-accent) 8%, transparent);
	}

	.article-link-card__link {
		position: relative;
		display: grid;
		grid-template-columns: auto 1fr;
		align-items: stretch;
		text-decoration: none !important;
		color: inherit !important;
		overflow: hidden;
	}

	.article-link-card__link:not(:has(.article-link-card__media)) {
		grid-template-columns: 1fr;
	}

	/* Top-Right Corner Watermark Logo with Radial Progressive Blur */
	.article-link-card__watermark {
		position: absolute;
		top: -15px;
		right: -15px;
		width: clamp(140px, 22vw, 210px);
		height: clamp(140px, 22vw, 210px);
		pointer-events: none;
		user-select: none;
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		opacity: 0.75;
		transition:
			opacity 240ms ease,
			transform 260ms cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	.article-link-card:hover .article-link-card__watermark {
		opacity: 1;
		transform: scale(1.08) translate(-3px, 3px);
	}

	.article-link-card__watermark-halo {
		position: absolute;
		inset: 12%;
		border-radius: 50%;
		background: radial-gradient(
			circle at center,
			color-mix(in srgb, var(--card-accent) 30%, transparent) 0%,
			color-mix(in srgb, var(--card-accent) 14%, transparent) 42%,
			transparent 72%
		);
		filter: blur(14px);
		pointer-events: none;
	}

	.article-link-card__watermark-img {
		position: absolute;
		width: 80%;
		height: 80%;
		object-fit: contain;
		pointer-events: none;
	}

	/* Sharp central layer fading towards the edges */
	.article-link-card__watermark-img--sharp {
		mask-image: radial-gradient(
			circle at 50% 50%,
			rgba(0, 0, 0, 0.95) 15%,
			rgba(0, 0, 0, 0.6) 38%,
			transparent 64%
		);
		-webkit-mask-image: radial-gradient(
			circle at 50% 50%,
			rgba(0, 0, 0, 0.95) 15%,
			rgba(0, 0, 0, 0.6) 38%,
			transparent 64%
		);
	}

	/* Progressive blur layer extending further outwards into the dark background */
	.article-link-card__watermark-img--blur {
		filter: blur(8px);
		opacity: 0.85;
		mask-image: radial-gradient(
			circle at 50% 50%,
			transparent 18%,
			rgba(0, 0, 0, 0.8) 45%,
			transparent 78%
		);
		-webkit-mask-image: radial-gradient(
			circle at 50% 50%,
			transparent 18%,
			rgba(0, 0, 0, 0.8) 45%,
			transparent 78%
		);
	}

	.article-link-card__media {
		position: relative;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: center;
		width: clamp(5.25rem, 8.5vw, 6.5rem);
		padding: 1.1rem;
		background-color: rgba(242, 245, 243, 0.03);
		border-right: 1px solid rgba(242, 245, 243, 0.1);
	}

	.article-link-card__icon {
		display: block;
		width: 100%;
		max-width: 64px;
		aspect-ratio: 1;
		object-fit: contain;
		border-radius: 12px;
		box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
		transition: transform 180ms ease;
	}

	.article-link-card:hover .article-link-card__icon {
		transform: scale(1.06);
	}

	.article-link-card__content {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 1.25rem 1.5rem;
		min-width: 0;
	}

	.article-link-card__top {
		position: relative;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.5rem;
	}

	.article-link-card__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.55rem;
	}

	.article-link-card__domain,
	.article-link-card__badge {
		font-family: var(--font-utility);
		font-size: 0.68rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		padding: 0.22rem 0.6rem;
		background: rgba(242, 245, 243, 0.08);
		color: var(--muted);
		clip-path: polygon(
			0.35rem 0,
			calc(100% - 0.35rem) 0,
			100% 50%,
			calc(100% - 0.35rem) 100%,
			0.35rem 100%,
			0 50%
		);
	}

	.article-link-card__badge {
		color: #ffffff;
		background: color-mix(in srgb, var(--card-accent) 32%, transparent);
		border: 1px solid color-mix(in srgb, var(--card-accent) 45%, transparent);
	}

	.article-link-card__arrow {
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--muted);
		transition:
			color 180ms ease,
			transform 180ms ease;
	}

	.article-link-card__arrow svg {
		width: 1.1rem;
		height: 1.1rem;
	}

	.article-link-card:hover .article-link-card__arrow {
		color: var(--card-accent);
		transform: translate(0.15rem, -0.15rem);
	}

	.article-link-card__title {
		position: relative;
		z-index: 2;
		margin: 0 0 0.35rem !important;
		font-size: 1.25rem !important;
		font-weight: 800;
		color: var(--paper) !important;
		transition: color 180ms ease;
	}

	.article-link-card:hover .article-link-card__title {
		color: var(--card-accent) !important;
	}

	.article-link-card__desc {
		position: relative;
		z-index: 2;
		margin: 0 !important;
		color: var(--muted) !important;
		font-size: 0.95rem !important;
		line-height: 1.55 !important;
	}

	@media (max-width: 560px) {
		.article-link-card__link {
			grid-template-columns: 1fr;
		}

		.article-link-card__media {
			width: 100%;
			border-right: none;
			border-bottom: 1px solid rgba(242, 245, 243, 0.1);
			padding: 1.25rem;
		}

		.article-link-card__icon {
			max-width: 56px;
		}

		.article-link-card__watermark {
			width: 130px;
			height: 130px;
			top: -10px;
			right: -10px;
			opacity: 0.55;
		}
	}
</style>
