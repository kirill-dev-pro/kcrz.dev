---
import { SITE_TITLE } from '../consts';
---

<header class="site-header">
	<nav aria-label="Primary navigation">
		<a class="site-header__brand" href="/">{SITE_TITLE}</a>
		<div class="site-header__links">
			<a href="/#about">About</a>
			<a href="/#work">Work</a>
			<a href="/blog">Blog</a>
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: fixed;
		inset: 0 0 auto;
		z-index: 20;
		padding: 0 var(--page-gutter);
		background: linear-gradient(180deg, rgba(5, 6, 8, 0.94), rgba(5, 6, 8, 0));
		pointer-events: none;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: min(100%, var(--content-max));
		min-height: 4.75rem;
		margin: 0 auto;
		border-bottom: 1px solid rgba(242, 245, 243, 0.12);
		pointer-events: auto;
	}

	nav a {
		color: var(--paper);
		text-decoration: none;
	}

	.site-header__brand {
		font-family: var(--font-display);
		font-size: 1rem;
		font-weight: 800;
		letter-spacing: -0.035em;
	}

	.site-header__links {
		display: flex;
		gap: clamp(1rem, 3vw, 2.5rem);
	}

	.site-header__links a {
		position: relative;
		padding: 0.55rem 0;
		font-family: var(--font-utility);
		font-size: 0.68rem;
		letter-spacing: 0.13em;
		text-transform: uppercase;
	}

	.site-header__links a::after {
		position: absolute;
		inset: auto 0 0;
		height: 1px;
		background: var(--bunderstack-violet);
		content: '';
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 160ms ease;
	}

	.site-header__links a:hover::after,
	.site-header__links a:focus-visible::after {
		transform: scaleX(1);
	}

	@media (max-width: 480px) {
		nav {
			min-height: 4rem;
		}

		.site-header__links {
			gap: 0.85rem;
		}
	}
</style>
