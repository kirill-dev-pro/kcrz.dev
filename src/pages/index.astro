---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/home/Hero.astro';
import ProjectGarden from '../components/home/ProjectGarden.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import '../styles/home.css';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="home-page">
		<canvas class="garden-scene-canvas" aria-hidden="true"></canvas>
		<Header />
		<main data-garden-root>
			<Hero />
			<ProjectGarden />
		</main>
		<Footer />

		<script>
			import { initGardenState } from '../scripts/garden-state';

			const gardenRoot = document.querySelector<HTMLElement>('[data-garden-root]');
			const sceneCanvas = document.querySelector<HTMLCanvasElement>('.garden-scene-canvas');
			if (gardenRoot && sceneCanvas) {
				const cleanupState = initGardenState(gardenRoot);
				import('../scripts/garden-scene').then(({ initGardenScene }) => {
					const cleanupScene = initGardenScene(sceneCanvas);
					window.addEventListener('pagehide', () => {
						cleanupScene();
						cleanupState();
					}, { once: true });
				});
			}
		</script>
	</body>
</html>
