---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Hero from '../components/home/Hero.astro';
import ProjectGarden from '../components/home/ProjectGarden.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import '../styles/home.css';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="home-page">
		<div class="hex-field" aria-hidden="true"></div>
		<canvas class="garden-scene-canvas" aria-hidden="true"></canvas>
		<Header />
		<main data-garden-root>
			<Hero />
			<ProjectGarden />
		</main>

		<script>
			import { initGardenState } from '../scripts/garden-state';
			import { initHexParallax } from '../scripts/hex-parallax';
			import { initTileProximity } from '../scripts/tile-proximity';

			const hexField = document.querySelector<HTMLElement>('.hex-field');
			if (hexField) initHexParallax(hexField);

			initTileProximity(
				Array.from(document.querySelectorAll<HTMLElement>('.project-territory')),
			);

			const gardenRoot = document.querySelector<HTMLElement>('[data-garden-root]');
			const sceneCanvas = document.querySelector<HTMLCanvasElement>('.garden-scene-canvas');
			if (gardenRoot && sceneCanvas) {
				let cleanupState: (() => void) | undefined;
				let cleanupScene: (() => void) | undefined;
				let sceneModule: Promise<typeof import('../scripts/garden-scene')> | undefined;
				let sceneGeneration = 0;
				let initialized = false;

				const initialize = () => {
					if (initialized) return;
					const generation = ++sceneGeneration;
					initialized = true;
					cleanupState = initGardenState(gardenRoot);
					const isSmallScreen = window.matchMedia('(max-width: 760px)').matches;
					if (!isSmallScreen) {
						sceneModule ??= import('../scripts/garden-scene');
						sceneModule.then(({ initGardenScene }) => {
							if (initialized && sceneGeneration === generation) cleanupScene = initGardenScene(sceneCanvas);
						}).catch(() => {
							if (initialized && sceneGeneration === generation) sceneCanvas.dataset.sceneFallback = 'true';
						});
					}
				};

				const dispose = () => {
					if (!initialized) return;
					sceneGeneration += 1;
					initialized = false;
					cleanupScene?.();
					cleanupState?.();
					cleanupScene = undefined;
					cleanupState = undefined;
				};

				window.addEventListener('pagehide', (event) => {
					if (event.persisted) dispose();
				});
				window.addEventListener('pageshow', (event) => {
					if (event.persisted) initialize();
				});
				initialize();
			}
		</script>
	</body>
</html>
