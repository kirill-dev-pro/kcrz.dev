---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/home/Hero.astro';
import ProjectGarden from '../components/home/ProjectGarden.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import '../styles/home.css';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="home-page">
		<Header />
		<main data-garden-root>
			<Hero />
			<ProjectGarden />
		</main>
		<Footer />

		<script>
			import { initGardenState } from '../scripts/garden-state';

			const gardenRoot = document.querySelector<HTMLElement>('[data-garden-root]');
			if (gardenRoot) initGardenState(gardenRoot);
		</script>
	</body>
</html>
